# Copie para .env e defina uma senha. O arquivo .env não vai para o Git.
POSTGRES_DB=s2id_lab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# Variáveis do libpq usadas pelos scripts Python e psql no seu computador
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=troque-esta-senha
PGDATABASE=s2id_lab
