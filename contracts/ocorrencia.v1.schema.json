{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Christiellen/disaster-risk-spatial-architecture/contracts/ocorrencia.v1.schema.json",
  "title": "Ocorrência de desastre - contrato v1",
  "description": "Registro público de uma ocorrência, como exposto por api.v1_ocorrencia. Campos só podem ser ACRESCENTADOS na v1; remoção, renomeação ou mudança de tipo exige v2.",
  "type": "object",
  "required": ["id", "cd_mun", "municipio", "uf", "cd_cobrade", "tipologia", "dt_evento", "danos",
               "total_pessoas_afetadas", "longitude", "latitude", "versao", "atualizado_em"],
  "properties": {
    "id":            {"type": "string", "minLength": 4, "description": "Identificador público estável (protocolo S2iD ou hash determinístico prefixado por 'H:')."},
    "protocolo":     {"type": ["string", "null"], "pattern": "^[A-Z0-9][A-Z0-9./-]{3,}$"},
    "cd_mun":        {"type": "string", "pattern": "^[0-9]{7}$"},
    "municipio":     {"type": "string", "minLength": 1},
    "uf":            {"type": "string", "pattern": "^[A-Z]{2}$"},
    "cd_cobrade":    {"type": "string", "pattern": "^[12][0-9]{4}$"},
    "tipologia":     {"type": "string", "minLength": 1},
    "grupo_cobrade": {"type": ["string", "null"]},
    "dt_evento":     {"type": "string", "format": "date"},
    "dt_registro":   {"type": ["string", "null"], "format": "date"},
    "situacao":      {"type": ["string", "null"]},
    "danos": {
      "type": "object",
      "description": "Indicador -> valor. Ausência da chave = não informado; 0 = informado como zero.",
      "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]+$"},
      "additionalProperties": {"type": "number", "minimum": 0}
    },
    "total_pessoas_afetadas": {"type": "integer", "minimum": 0},
    "longitude":     {"type": "number", "minimum": -75, "maximum": -28},
    "latitude":      {"type": "number", "minimum": -35, "maximum": 6},
    "versao":        {"type": "integer", "minimum": 1, "description": "Enviar de volta em alterações (concorrência otimista)."},
    "atualizado_em": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
